{
  "name": "study-nest",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "author": "Khalid",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.khalid.studynest",
    "productName": "Study Nest",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "script.js",
      "ai-tutor.js",
      "preload.js",
      "pdf.min.js",
       "libs/**/*"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.1"
  }
}
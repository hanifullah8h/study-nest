{
  "name": "study-nest",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "author": "Khalid",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
  "appId": "com.hanifullah8h.studynest",
  "productName": "Study Nest",
  "asarUnpack": [
    "**/node_modules/node-llama-cpp/**/*"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Study Nest"
  }
},
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.1"
  }
}